{
  "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "!/ngsw-worker.js",
          "!/safety-worker.js",
          "!/worker-basic.min.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/media/**",
          "/assets/icons/**",
          "/assets/pwa/**",
          "/assets/nav/**",
          "/assets/logo-compass.png",
          "!/assets/export-from-lostark-helper.js"
        ]
      }
    },
    {
      "name": "ant-icons",
      "installMode": "lazy",
      "resources": {
        "files": [
          "/assets/outline/**",
          "/assets/fill/**",
          "/assets/twotone/**",
          "/assets/animal/**"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "export-script",
      "urls": ["/assets/export-from-lostark-helper.js"],
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "5s",
        "maxAge": "7d",
        "maxSize": 1
      }
    }
  ]
}
