{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "target": "client",
    "public": "dist/apps/client/browser",
    "ignore": [
      "**/.*"
    ],
    "headers": [
      {
        "source": "*.(png|webp|jpg)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "regex": "^/[^/]+-[A-Z0-9]{8}\\.(css|js)$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8085
    },
    "ui": {
      "enabled": false
    }
  }
}
